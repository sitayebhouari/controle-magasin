{
  "name": "controle-magasin-desktop",
  "version": "1.0.1",
  "description": "Controle Magasin - Achat et Stock",
  "main": "main.js",
  "author": "FibreApp",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fibreapp.controlemagasin",
    "productName": "Controle Magasin",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "shell.html", "package.json"],
    "extraResources": [
      { "from": "R-Portable", "to": "R-Portable" },
      { "from": "shiny_achat", "to": "shiny_achat" },
      { "from": "shiny_stock", "to": "shiny_stock" }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

